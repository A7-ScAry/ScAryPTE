# Configure these in Vercel Project > Settings > Environment Variables.
# Never commit a real .env file or put secret values into client-side JavaScript.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional but recommended for private use. Before opening public service add proper auth and quotas.
SCARY_ACCESS_PIN=
